DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional, SOLO para pruebas en red local (otro equipo entrando por http://IP-LAN sin
# HTTPS): pone la cookie del refresh token en Secure=False / SameSite=Lax en vez del
# valor seguro por defecto. No usar en producción — dejar sin definir (o en True).
# DJANGO_REFRESH_COOKIE_SECURE=False

DB_ENGINE=mssql

# --- SQL Server 2022 (contenedor Docker; ver docker-compose.yml) ---
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_NAME=sgsi_iso27001
MSSQL_USER=sa
MSSQL_SA_PASSWORD=

# --- MySQL (solo si DB_ENGINE=mysql, o como origen para migrar datos) ---
DB_NAME=sgsi_iso27001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# --- MySQL de origen, solo para el script de migración de datos a SQL Server ---
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_NAME=sgsi_iso27001
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP para códigos OTP por correo. Vacío = se imprimen en la consola del servidor.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
